# Copy to .env and fill in. The backend reads these at startup.

# CORS: comma-separated origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173

# Max upload size in megabytes
MAX_UPLOAD_MB=25

# Per-IP rate limits. Any slowapi rate-limit string works, e.g. "10/hour",
# "100/day", "5/minute". Exceeding one returns 429 with a Retry-After header.
#
# AI_RATE_LIMIT covers /api/ai-analysis and /api/color-grade — endpoints whose
# entire job is a paid Anthropic call.
# ANALYZE_RATE_LIMIT covers /api/analyze, which is mostly local CV but escalates
# to a paid Claude call when the subject detector is unsure, so it needs a
# ceiling too — just a much higher one, sized to stop abuse rather than use.
AI_RATE_LIMIT=10/hour
ANALYZE_RATE_LIMIT=60/hour

# How many analyses may run concurrently. The route handlers are synchronous,
# so this sizes the threadpool Starlette runs them in. 0 = auto (cpu_count,
# clamped to 2-8). Each in-flight request holds a full-resolution image decode,
# so raise this only alongside the memory to match.
ANALYSIS_CONCURRENCY=0

# Root log level (DEBUG | INFO | WARNING | ERROR). uvicorn only configures its
# own loggers, so without the app's setup every warning it emits — VLM
# fallbacks, unparseable AI responses, model load failures — goes nowhere.
# Noisy libraries (PIL, matplotlib, httpx) stay capped at WARNING.
LOG_LEVEL=INFO

# Peak-memory bounds. Both are what let the lite build fit a 512MB instance.
# DECODE_MAX_EDGE asks libjpeg to decode JPEGs at a reduced scale instead of
# decoding full-size and shrinking (26MP frame: 238MB -> 86MB of peak RSS).
# MAX_ANALYSIS_MEGAPIXELS backstops formats without scaled decoding (PNG, WEBP).
# Neither costs accuracy — every metric already caps itself at 1920px — but
# sharpness reads ~16% lower under scaled decode. Set either to 0 to disable.
DECODE_MAX_EDGE=1920
MAX_ANALYSIS_MEGAPIXELS=12

# --- AI providers (added when we wire up the VLM/LLM features) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Pause the Claude critique and serve a fixed placeholder instead.
# Useful while working on the frontend: the report renders end-to-end
# without spending an Anthropic call per upload.
AI_ANALYSIS_PAUSED=false

# --- Logging -----------------------------------------------------------------
# json: one object per line (production log collectors). text: human-readable.
# Both carry request_id / job_id / analysis_id and per-stage timings.
LOG_FORMAT=text

# --- Persistence + background jobs -------------------------------------------
# SQLite (default) is right for one instance. Use Postgres for history that
# survives redeploys or for more than one replica/worker process; a bare
# postgres:// URL from Render/Heroku is accepted.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/framegrader
DATABASE_URL=sqlite:///./data/framegrader.db
# Worker threads inside the API process. 0 = run `python -m app.worker` instead.
EMBEDDED_WORKERS=1
# A running job silent for this long is presumed dead and requeued.
JOB_STALE_SECONDS=180
JOB_MAX_ATTEMPTS=2
# Analyses and their stored photos are deleted after this many days (0 = never).
RETENTION_DAYS=30
# Signs image URLs for private analyses. Unset = random per process, which is
# fine for one instance; replicas must share one.
# SECRET_KEY=
STORED_IMAGE_MAX_EDGE=2048

# --- Learned aesthetic score -------------------------------------------------
# ONNX model + .json sidecar from eval/benchmark/export_onnx.py. Missing file =
# feature off (the composition score uses its geometry-only calibration).
AESTHETIC_ENABLED=true
AESTHETIC_MODEL_PATH=models/aesthetic.onnx
AESTHETIC_THREADS=2
