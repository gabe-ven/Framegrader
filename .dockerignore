# Build context is backend/. Keep it small and keep secrets out.

# Secrets — .env holds ANTHROPIC_API_KEY. Pass it at runtime
# (--env-file / platform secrets), never bake it into a layer.
.env
.env.*
!.env.example

# Local virtualenv: hundreds of MB, and macOS wheels are useless in the image.
.venv/
venv/

# Weights are downloaded during the build; shipping the local copies would add
# ~165MB to the context (including the unused yolov8x checkpoint).
*.pt

# Tests and caches
tests/
.pytest_cache/
.mypy_cache/
.ruff_cache/
__pycache__/
*.py[cod]

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
